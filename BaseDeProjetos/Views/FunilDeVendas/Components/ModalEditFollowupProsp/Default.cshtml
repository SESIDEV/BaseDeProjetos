@model BaseDeProjetos.Models.FollowUp
@using BaseDeProjetos.Models.Enums;
@using Microsoft.AspNetCore.Http
@using System.Globalization
@{
    ViewData["Title"] = "Atualizar Prospecção";
    if (!(Context.Session.GetString("_Casa") is null))
    {
        ViewData["Area"] = Context.Session.GetString("_Casa");
    }

    var prosp = ViewData["prospeccao"] as Prospeccao;

    IEnumerable<SelectListItem> FiltrarExcecao(IEnumerable<SelectListItem> lista, Prospeccao prosp)
    {
        // Ao editar um followup específico, devemos permitir apenas status coerentes entre o status
        // anterior e o próximo (considerando desempate por Data e Id). Isso evita que a edição de um
        // followup antigo force-o para o último status da prospecção.

        var ordenados = prosp.Status.OrderBy(s => s.Data).ThenBy(s => s.Id).ToList();

        // Encontrar o followup atual dentro da prospecção pelo Id do Model (caso exista)
        var atual = ordenados.FirstOrDefault(s => s.Id == Model.Id) ?? Model;

        // status anterior (se houver)
        var anterior = ordenados.Where(s => s.Data < atual.Data || (s.Data == atual.Data && s.Id < atual.Id)).LastOrDefault();

        // status seguinte (se houver)
        var proximo = ordenados.Where(s => s.Data > atual.Data || (s.Data == atual.Data && s.Id > atual.Id)).FirstOrDefault();

        int minVal = anterior != null ? (int)anterior.Status : (int)StatusProspeccao.ContatoInicial;
        int maxVal = proximo != null ? (int)proximo.Status : int.MaxValue;

        return lista.Where(status =>
        {
            int v = Int32.Parse(status.Value);
            if (atual.Status == StatusProspeccao.ContatoInicial)
            {
                return v == (int)StatusProspeccao.ContatoInicial;
            }

            // nunca permitir Planejada ou Agregada como escolha direta
            if (v == (int)StatusProspeccao.Planejada || v == (int)StatusProspeccao.Agregada) return false;
            return v >= minVal && v <= maxVal;
        });
    }

}


<div class="modal fade" id="EditFollowupProspModal-@Model.Id" tabindex="-1"
     aria-labelledby="EditFollowupProspModal-@Model.Id-Label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered funil-status-modal-dialog">
        <div class="modal-content funil-status-modal">
            <form asp-controller="FunilDeVendas" asp-action="EditarFollowUp" asp-route-id="@Model.Id" method="POST">
                <div class="funil-status-modal-header">
                    <div>
                        <h1 class="funil-status-modal-title" id="EditFollowupProspModal-@Model.Id-Label">
                            Editar status da prospec&ccedil;&atilde;o
                        </h1>
                        <p>Ajuste a data, o est&aacute;gio ou as observa&ccedil;&otilde;es deste status.</p>
                    </div>
                    <button type="button" class="btn-close funil-status-modal-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="funil-status-modal-body">
                    <div class="accordion" id="accordionFlushExample">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="flush-headingOne">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOne" aria-expanded="false" aria-controls="flush-collapseOne">
                                    Dados da Prospecção
                                </button>
                            </h2>
                            <div id="flush-collapseOne" class="accordion-collapse collapse" aria-labelledby="flush-headingOne" data-bs-parent="#accordionFlushExample">
                                <div class="accordion-body">
                                    <div class="form-group">
                                        <label asp-for="Id" class="control-label"></label>
                                        <input type="text" class="form-control" value="@prosp.Id" readonly />
                                        <span asp-validation-for="Id" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label> Empresa </label>
                                        <input type="text" class="form-control" value="@prosp.Empresa.Nome" readonly />
                                    </div>
                                    <div class="form-group">
                                        <label> Casa </label>
                                        <input type="text" class="form-control" value="@prosp.Casa.GetDisplayName()" readonly />
                                    </div>
                                    <div class="form-group">
                                        <label> Tipo de Contratação </label>
                                        <input type="text" class="form-control" value="@prosp.TipoContratacao.GetDisplayName()" readonly />
                                    </div>
                                    <div class="form-group">
                                        <label> Status </label>
                                        <input type="text" class="form-control" value="" placeholder="@prosp.Status.Last().Status.GetDisplayName()"
                                               readonly />
                                    </div>
                                    <div class="form-group">
                                        <label> Contato da prospecção</label>
                                        @{
                                            if (prosp.Contato == null)
                                            {
                                                <input type="text" class="form-control" value="Sem Contato" readonly />
                                            }

                                            else
                                            {
                                                <input type="text" class="form-control" value="@prosp.Contato.Nome" readonly />
                                            }
                                        }
                                    </div>
                                    <div class="form-group">
                                        <label>Informações da prospecção (Primeiro Contato)</label>
                                        <textarea type="text" class="form-control" value="@prosp.Status.First().Anotacoes" readonly>@prosp.Status.First().Anotacoes
                                        </textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <br>

                    <input asp-for="OrigemID" type="hidden" value="@Model.OrigemID" />
                    <input asp-for="Id" type="hidden" value="@Model.Id" />

                    <div class="funil-status-field">
                        <label asp-for="Data" class="form-label"></label>
                        <div class="funil-status-input-icon">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                            <input asp-for="Data" type="date" class="form-control" />
                        </div>
                        <small class="form-text text-muted">Data atual: @Model.Data.ToString("dd/MM/yyyy", CultureInfo.CreateSpecificCulture("pt-BR"))</small>
                        <span asp-validation-for="Data" class="text-danger"></span>
                    </div>
                    <div class="funil-status-field">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" value="@Model.Status" class="form-select"
                                asp-items="FiltrarExcecao(Html.GetEnumSelectList<StatusProspeccao>(), @prosp)"></select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                    <div class="funil-status-field">
                        <label asp-for="Anotacoes" class="form-label"></label>
                        <textarea class="form-control" asp-for="Anotacoes" rows="3" required> @Model.Anotacoes</textarea>
                        <span asp-validation-for="Anotacoes" class="text-danger"></span>
                    </div>
                    <div id="naoconversao" style="display:none">
                        <div class="form-group">
                            <label class="control-label"> Motivo de não conversão:</label>
                            <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<MotivosNaoConversao>()"></select>
                        </div>
                        </div>
                    </div>
                <div class="funil-status-modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar altera&ccedil;&otilde;es</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    (function () {
        var modal = document.getElementById('EditFollowupProspModal-@Model.Id');
        var dateControl = modal ? modal.querySelector('input[type="date"]') : null;
        if (dateControl) {
            dateControl.max = new Date(new Date().getTime() - new Date().getTimezoneOffset() * 60000).toISOString().split("T")[0];
        }
    })();
</script>
